# ════════════════════════════════════════════════
#  Levi-MD — Configuración de entorno
#  (base: Shin-MD · github.com/riokuroxi-svg/Shin-MD)
#  Copia este archivo a .env y rellena tus datos
# ════════════════════════════════════════════════

# ── OBLIGATORIO: sin esto el bot NO te reconoce como dueño ──────────
# 1) Copia este archivo:   cp .env.example .env
# 2) Pon aquí TU número (el de tu WhatsApp personal, NO el del bot).
#    Solo dígitos, sin + ni espacios. México MÓVIL: en WhatsApp el JID
#    guarda el formato viejo 52+1+número (ej. 5215574370309). Pon ESA —
#    el bot ya acepta también la forma corta, pero la de 13 dígitos es la buena.
# Honduras: +504 9487-4330 → 50494874330
OWNER_NUMBER=50494874330
# Nombre que se muestra en .owner
OWNER_NAME=Brayan

# ── Conexión ──────────────────────────────────
# Método de vinculación: 'code' para pairing, 'qr' para QR
PAIRING_METHOD=code
# Número para pairing (solo dígitos, sin +)
PAIRING_NUMBER=

# ── Logging ───────────────────────────────────
# Niveles: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# ── Servidor ──────────────────────────────────
PORT=3000
# Poner LOOPBACK=0 para exponer el panel en la red
LOOPBACK=1
# ⚠️ OBLIGATORIO si LOOPBACK=0: contraseña del panel web (usuario: admin).
# Sin ella el panel vuelve a 127.0.0.1 automáticamente (failsafe).
# PANEL_PASSWORD=pon_aqui_una_clave_larga

# ── Logs ──────────────────────────────────────
# El bot guarda logs en logs/shin-YYYY-MM-DD.log (rotación diaria, 7 días)
# para poder debuggear desconexiones/bans. Pon LOG_FILE=0 para apagarlo.
# LOG_FILE=0

# ── Warm-up anti-ban (tope diario de mensajes) ─
# El bot limita cuántos mensajes envía al día para no ser baneado.
# Día 0 = 20 mensajes, subiendo hasta 500 al día 7. Al llegar al tope,
# los comandos normales dejan de responder (.menu y .ping siguen).
# Revísalo en cualquier momento con el comando .warmup
#
# ⚠️ IMPORTANTE si tu hosting NO guarda la base de datos entre deploys
# (Railway/Render sin volumen, reinstalar Termux): la fecha de inicio se
# reinicia y el bot se queda para siempre en el día 0 = 20 msj/día.
# Fija aquí el día en que empezaste a usar el número (AAAA-MM-DD):
# WARMUP_START_DATE=2026-09-01
#
# Mensajes permitidos el primer día (por defecto 20)
# WARMUP_START_MSGS=60
# Mensajes permitidos al terminar el warm-up (por defecto 500)
# WARMUP_MAX_MSGS=800
# Días que dura la subida (por defecto 7, o 2 si el número es veterano)
# WARMUP_DAYS=7
# Quitar el tope diario por completo. El delay entre mensajes SE MANTIENE
# (eso es lo que de verdad protege del ban), pero sin límite de cantidad.
# Úsalo solo con un número ya asentado, con semanas de uso normal.
# WARMUP=off

# ── Música / MP3 ──────────────────────────────
# Portada que se incrusta en los MP3 (.play, .mp3, .ytmp3):
#  · Pon tus imágenes en media/covers/ (jpg o png, máx 500KB, ideal 500x500)
#    y el bot elige una al azar en cada canción.
#  · O deja una sola en media/audio-cover.jpg
# Nombre del álbum y artista por defecto en las etiquetas ID3:
# MUSIC_ALBUM_NAME=Shin-MD
# MUSIC_ARTIST_NAME=Shin-MD

# ── Menú ──────────────────────────────────────
# URL opcional de imagen de banner para el menú
MENU_IMAGE=

# Estilo del menú: auto = tarjeta nativa con botones y lista desplegable
# (con fallback a texto si algo falla) · text = menú clásico de texto.
MENU_STYLE=auto

# ⚠️ RIESGO DE BAN — dejar en 0 salvo que sepas lo que haces.
# Con 1 añade "reenviado muchas veces" + tag de canal a los mensajes con
# tag verde (trucos estéticos de los bots indonesios; señal detectable).
RICH_EXTRA=0

# ── Compatibilidad con WhatsApp ───────────────
# Nodo `bot` (biz_bot=1): marca los mensajes como "de un bot de IA".
# Los WhatsApp viejos NO saben pintarlo y muestran:
#   "Recibiste un mensaje que no es compatible con tu versión de WhatsApp"
# Déjalo en 0. Sólo pon 1 si TODOS tus usuarios tienen WhatsApp al día.
WA_BOT_NODE=0

# Modo seguro de mensajes: degrada a texto los tipos que los clientes
# viejos no pintan (evento de calendario, álbum, tarjetas de IA...).
# Es lo que evita el aviso "Actualizar WhatsApp". Déjalo en 1.
WA_SAFE_MODE=1
# Tipos que SÍ quieres mandar aunque sean riesgosos (coma, sin espacios):
#   eventMessage, albumMessage, richResponseMessage
# WA_ALLOW_TIPOS=eventMessage

# ── Creadores ─────────────────────────────────
# Aparecen en .creadores y también pueden usar los comandos de owner.
# Formato: numero:Nombre  (separados por coma si hay varios).
# Sin nombre también vale, pero la tarjeta sale más fea.
CREATORS=5215574370309:riokuroxi-svg

# Nombre viejo de la misma lista. Se sigue leyendo para no romper
# instalaciones que ya lo tenían. Si usas CREATORS, puedes borrar esta.
OWNERS=5215574370309

# Para añadir a alguien más sin editar este archivo:
#   .addowner 5215555555555 Nombre     (y .delowner para quitarlo)
# Se guarda en data/creadores.json y sobrevive a las actualizaciones.

# ── Redes y Enlaces ───────────────────────────
# Enlace de Instagram oficial del creador
INSTAGRAM_LINK=https://www.instagram.com/__ikg.05

# ── Descargas (.play) ─────────────────────────
# URL de tu API de conversión YouTube→MP3. Debe incluir {url}
# (y {key} si usa API key). Si la dejas vacía, usa fallbacks públicos.
# Ejemplo: https://tu-api.com/ytmp3?url={url}&apikey={key}
YT_API_URL=
# API key (opcional) que se sustituye en {key}
YT_API_KEY=

# Activar descarga directa con ytdl-core (puro Node.js, sin binarios).
# Útil si las APIs externas no funcionan. Requiere Node >= 18.
# TIP: si la IP de tu servidor está bloqueada por YouTube, sube tus
# cookies con el comando .subircookies (usa cuenta secundaria); este
# modo las usa automáticamente.
YTDL_ENABLED=0

# Ruta alternativa del archivo de cookies (por defecto ./cookies.txt)
# COOKIES_FILE=./cookies.txt

# Cliente de YouTube para yt-dlp. Vacío = el que elige yt-dlp (el que
# funciona desde VPS). Solo cámbialo si YouTube vuelve a bloquear:
# YTDLP_PLAYER_CLIENTS=android,web,web_embedded

# ── API de Redes Sociales (FastSaver) ─────────
# Key GRATIS de api.fastsaver.io (1,000 créditos/mes, sin tarjeta).
# Hace funcionar: .instagram, .twitter, .pinterest y más.
# Regístrate en: https://api.fastsaver.io
# FASTSAVER_KEY=fs_sk_tu_key_aqui

# ── Stickers ──────────────────────────────────
# Nombre del pack de stickers (se muestra en la info del sticker)
STICKER_PACK=Shin-MD
# Autor del sticker
STICKER_AUTHOR=@ShinBot

# ── Perfil del número (anti-ban) ──────────────
# nuevo      = delay base 1500ms + warm-up de 7 días (números recién vinculados)
# veterano   = delay base 400ms  + sin límite diario (recomendado para bots activos)
# auto       = elige solo: nuevo si llevas <7 días con el bot, veterano si no.
NUMBER_PROFILE=veterano
# Desactivar límite de warm-up (0 = ilimitado, sin pausas de 60s)
WARMUP_LIMIT=0

# ── Prefijo de comandos ───────────────────────
BOT_PREFIX=.

# ── Antispam y estilo ─────────────────────────
# El bot tiene dos capas de antispam: la de siempre (10 mensajes por minuto)
# y el "brain" (ráfagas cortas, texto repetido, flood de comandos). Si algún
# día notes que ignora a alguien que no debería, apaga SOLO el brain con esto
# y queda la capa de siempre:
# SHIN_BRAIN=0
# El estilo de los mensajes (negritas/cursivas automáticas) se apaga igual:
# SHIN_ESTILO=0
# Doble palomita azul en los comandos (el usuario ve que el bot lo leyó).
# Para apagarla:
# READ_RECEIPTS=0

# ── Mantenimiento 24/7 ────────────────────────
# Aviso en el log si el bot pasa de esta RAM (MB). 0 = no vigilar.
# MEM_LIMIT_MB=512
# Reiniciar al pasar el límite. SOLO si algo vuelve a levantar el bot
# (PM2, systemd o el panel del hosting); si no, el bot se quedaría apagado.
# MEM_RESTART=1
# Los temporales que quedan tirados se borran pasados estos minutos.
# TEMP_MAX_AGE_MIN=60

# ── Rutas (para pruebas o despliegues raros) ──
# Carpeta de la sesión de WhatsApp (por defecto ./Sessions/Owner):
# SESSION_DIR=/ruta/a/otra/sesion
# Archivo de la base de datos (por defecto data/shin.db):
# SHIN_DB_PATH=/ruta/a/otra/base.db
